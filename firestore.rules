rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// EcoSpark Firestore security rules
//
// Governing principle: the client may never write anything of value. Points,
// roles, bans and inventory are mutated only by the trusted serverless functions
// in api/ (Admin SDK, which bypasses these rules by design). What remains here
// is the boundary for everything the browser is still allowed to touch.
//
// Verify with the emulator before deploying:
//   firebase emulators:start --only firestore
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }



    function getRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let role = userDoc != null ? userDoc.data.get('role', 'student') : 'student';
      // Default to 'student' if role is null, undefined, or empty string
      return (role == null || role == '' || role == 'user') ? 'student' : role;
    }

    function isSupremeAdmin() {
      // Safely check for supreme admins. If token doesn't have email, it returns false instead of crashing.
      return isAuthenticated() && (request.auth.token.email == 'amiteshyadav.yt@gmail.com' || request.auth.token.email == 'shivika.op@gmail.com');
    }

    function isOwner() {
      return isSupremeAdmin() || (isAuthenticated() && getRole() == 'owner');
    }

    function isAdmin() {
      return isSupremeAdmin() || (isAuthenticated() && (getRole() == 'admin' || getRole() == 'owner' || getRole() == 'teacher'));
    }

    function isStaff() {
      return isSupremeAdmin() || (isAuthenticated() && (getRole() == 'teacher' || getRole() == 'admin' || getRole() == 'owner'));
    }

    function touchesProtectedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'banned'
      ]);
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // ── USERS ──────────────────────────────────────────────────────────────
    // Previously `allow update: if isAuthenticated()`, which let any signed-in
    // user rewrite any other user's points, role and inventory.
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Ensure users cannot create an account with a role other than 'user'
      allow create: if isSelf(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      // Since we are running fully client-side without Vercel API, 
      // users must be allowed to update their own stats/inventory.
      allow update: if isStaff() || (isSelf(userId) && !touchesProtectedFields());

      // Deletion would orphan ledger entries and leaderboard rows unless handled properly by the admin client.
      allow delete: if isStaff();
    }

    // ── POINT LEDGER (append-only, server-written) ─────────────────────────
    match /pointTransactions/{entryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow create, update: if false;
      allow delete: if isStaff();
    }

    // ── AUDIT LOG (owner-readable, server-written) ─────────────────────────
    match /auditLog/{entryId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ── TASKS ──────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ── SUBMISSIONS ────────────────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();

      // A student may submit their own work, but must not pre-set the verdict
      // or the payout — those come from verification and the task definition.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Status transitions belong to the verifier and to staff review.
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }

    // ── LEADERBOARD (public read, server-written) ─────────────────────────
    // Was writable by the row's owner, which meant points could be forged here
    // even once /users was locked.
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isStaff();
    }

    // ── REWARDS CATALOG ────────────────────────────────────────────────────
    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ── REDEMPTIONS / TRANSACTIONS (server-written) ───────────────────────
    match /redemptions/{redemptionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // ── ORACLE PREDICTION MARKETS (live board) ─────────────────────────────
    // Markets are REAL: seeded from live crypto prices / search-grounded
    // events, and settled only from verified real-world evidence. Anyone
    // signed in can read the board; anyone may push the market forward by
    // placing a bet (their own stake, recorded on their own profile).
    // Settlement fields and market status are frozen the moment a market is
    // decided, so no client can rewrite a result or re-open a market.
    match /oracleMarkets/{marketId} {
      allow read: if isAuthenticated();

      function isBetForward() {
        let diff = request.resource.data.diff(resource.data);
        return
          diff.affectedKeys().hasOnly([
            'options', 'totalStaked', 'betCount'
          ]) &&
          // Stakes and bet count may only ever go up.
          request.resource.data.totalStaked > resource.data.totalStaked &&
          request.resource.data.betCount == resource.data.betCount + 1 &&
          // Options count and ids are immutable — only stakes may move.
          request.resource.data.options.size() == resource.data.options.size();
      }

      allow update: if isAuthenticated() &&
        resource.data.status == 'active' && isBetForward();

      // Anyone signed in may publish a market. The market carries no value
      // until somebody bets on it (the update rule below) and settlement is
      // frozen once it leaves the active state — so creation is safe.
      // endTime is an ISO-8601 string (matching the rest of the codebase).
      allow create: if isAuthenticated() &&
        request.resource.data.status == 'active' &&
        request.resource.data.options.size() == 2 &&
        request.resource.data.endTime is string &&
        request.resource.data.endTime.size() >= 10;

      // Status, settlement fields, and the existence of the doc itself are
      // not client-controllable.
      allow delete: if false;
    }

    // ── ARENA (server-written) ────────────────────────────────────────────
    match /oracleBets/{betId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow write: if false;
    }

    match /growthPoolStakes/{stakeId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow write: if false;
    }

    match /arenaTriviaSessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow write: if false;
    }

    match /oracleQuestions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ── COMMUNITY POSTS ────────────────────────────────────────────────────
    match /community/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Author may edit their own post; anyone may toggle a like or bump the
      // comment count, and nothing else.
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'imageUrl', 'updatedAt'])) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'commentCount', 'reactions'])
      );
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isStaff());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isStaff());
      }
    }

    // ── GROUPS ─────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        // Joining/leaving only. totalPoints is server-maintained.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
      );
      allow delete: if isStaff();
    }

    // ── REPORTS ────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read, update, delete: if isStaff();
      allow create: if isAuthenticated();
    }

    // ── NOTIFICATIONS ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      // Recipient may only flip `read`.
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow update: if isStaff();
      // Client-created notifications remain allowed so DM/follow alerts keep
      // working; they carry no value and are addressed to a single recipient.
      allow create: if isAuthenticated() && (request.resource.data.type in ['follow', 'message'] || isStaff());
      allow delete: if isStaff();
    }

    // ── FOLLOWS ────────────────────────────────────────────────────────────
    // Doc id is `${followerId}_${followingId}`; a user may only create the edge
    // where they are the follower.
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.followerId == request.auth.uid;
      allow update: if false;
    }
    // ── SETTINGS ───────────────────────────────────────────────────────────
    // Public read: the landing page and maintenance gate read this pre-auth.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── FRAME REQUESTS ─────────────────────────────────────────────────────
    match /frameRequests/{requestId} {
      allow read, update, delete: if isStaff();
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;
    }

    // ── CHATS & MESSAGES ───────────────────────────────────────────────────
    // Was `allow read, write: if isAuthenticated()` — every conversation in the
    // app was readable and writable by any signed-in account.
    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      // Participants may update conversation metadata (lastMessage, unreadBy).
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        // You may only send as yourself, and only into a chat you are in.
        allow create: if isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid;
        // Editing is limited to reactions and read receipts; message text is
        // immutable so history cannot be rewritten after the fact.
        allow update: if isChatParticipant(chatId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'readBy', 'editedAt', 'deleted']);
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
      }
    }
  }
}
