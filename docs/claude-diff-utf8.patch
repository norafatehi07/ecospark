+// the odds actually rolled.
+//
+// Drop weight per tier. Higher weight = more common.
+export const TIER_WEIGHTS = {
+  bronze: 50,
+  silver: 50,
+  gold: 20,
+  platinum: 10,
+  god: 3,
+  gaia: 1,
+  supernova: 1,
+  quantum: 3,
