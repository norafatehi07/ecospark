+  top: 50%; left: 50%;
+  width: 190%; height: 190%;
+  transform: translate(-50%, -50%);
+  background: conic-gradient(from 0deg,
+    transparent 0deg, rgba(52, 211, 153, 0.28) 40deg, transparent 90deg,
+    rgba(240, 171, 252, 0.24) 150deg, transparent 210deg,
+    rgba(167, 139, 250, 0.22) 280deg, transparent 340deg);
+  animation: horizon-swirl 14s linear infinite;
+  pointer-events: none;
+}
+.bg-eventhorizon::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background-image:
+    radial-gradient(1px 1px at 25px 35px, #ffffff, rgba(0,0,0,0)),
+    radial-gradient(1.5px 1.5px at 70px 80px, #A7F3D0, rgba(0,0,0,0)),
+    radial-gradient(1px 1px at 110px 20px, #F0ABFC, rgba(0,0,0,0));
+  background-repeat: repeat;
+  background-size: 130px 130px;
+  animation: twinkle 4s infinite alternate;
+  pointer-events: none;
+}
+@keyframes horizon-swirl {
+  100% { transform: translate(-50%, -50%) rotate(360deg); }
+}
