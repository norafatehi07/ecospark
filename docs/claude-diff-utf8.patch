+/* ============================================================
+   ULTRA REWARDS ΓÇö QUANTUM / MYTHIC / SINGULARITY GLOWS
+   ============================================================ */
+.glow-photon {
+  background: linear-gradient(90deg, #67E8F9, #FFFFFF, #22D3EE, #0891B2, #67E8F9);
+  background-size: 250% auto;
+  color: transparent;
+  -webkit-background-clip: text;
+  background-clip: text;
+  animation: photon-stream 1.8s linear infinite;
+  text-shadow: 0 0 18px rgba(34, 211, 238, 0.9), 0 0 32px rgba(34, 211, 238, 0.5);
+  font-weight: bold;
+  display: inline-block;
+}
+@keyframes photon-stream {
+  0% { background-position: 0% center; }
+  100% { background-position: -250% center; }
+}
+
+.glow-chlorophyll {
+  background: linear-gradient(120deg, #14532D, #4ADE80, #ECFDF5, #22C55E, #14532D);
+  background-size: 300% auto;
+  color: transparent;
+  -webkit-background-clip: text;
+  background-clip: text;
+  animation: chlorophyll-surge 3s ease-in-out infinite;
+  text-shadow: 0 0 16px rgba(74, 222, 128, 0.9), 0 0 30px rgba(74, 222, 128, 0.5);
+  font-weight: bold;
+  display: inline-block;
+}
+@keyframes chlorophyll-surge {
+  0%, 100% { background-position: 0% center; filter: brightness(1); }
+  50% { background-position: 150% center; filter: brightness(1.35); }
+}
+
+.glow-eventbloom {
+  background: linear-gradient(90deg, #F0ABFC, #34D399, #A78BFA, #F0ABFC);
+  background-size: 280% auto;
+  color: transparent;
+  -webkit-background-clip: text;
+  background-clip: text;
+  animation: event-bloom 2.6s ease-in-out infinite;
+  text-shadow: 0 0 20px rgba(240, 171, 252, 0.9), 0 0 40px rgba(52, 211, 153, 0.5);
+  font-weight: bold;
+  display: inline-block;
+}
+@keyframes event-bloom {
+  0%, 100% { background-position: 0% center; letter-spacing: 0; transform: scale(1); }
+  50% { background-position: 200% center; letter-spacing: 1.5px; transform: scale(1.04); }
+}
+
+/* ============================================================
+   ULTRA REWARDS ΓÇö QUANTUM / MYTHIC / SINGULARITY BACKGROUNDS
+   ============================================================ */
+.bg-solargrid {
+  background-color: #071B2B !important;
+  background-image:
+    linear-gradient(rgba(34, 211, 238, 0.12) 1.5px, transparent 1.5px),
+    linear-gradient(90deg, rgba(34, 211, 238, 0.12) 1.5px, transparent 1.5px),
+    radial-gradient(circle at 80% 15%, rgba(253, 224, 71, 0.22), transparent 45%) !important;
+  background-size: 46px 46px, 46px 46px, 100% 100%;
+  position: relative;
+  overflow: hidden;
+  min-height: 100vh;
+  border-radius: 16px;
+  padding: 24px;
+}
+.bg-solargrid::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(115deg, transparent 42%, rgba(253, 224, 71, 0.14) 48%, rgba(255, 255, 255, 0.22) 50%, rgba(253, 224, 71, 0.14) 52%, transparent 58%);
+  background-size: 280% 100%;
+  animation: solar-sweep 6s ease-in-out infinite;
+  pointer-events: none;
+}
+@keyframes solar-sweep {
+  0% { background-position: 120% 0; }
+  100% { background-position: -160% 0; }
+}
+
+.bg-terraform {
+  background: linear-gradient(180deg, #052E16 0%, #14532D 35%, #B45309 78%, #FDE047 120%) !important;
+  position: relative;
+  overflow: hidden;
+  min-height: 100vh;
+  border-radius: 16px;
+  padding: 24px;
+}
+.bg-terraform::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: repeating-linear-gradient(0deg, transparent 0 26px, rgba(74, 222, 128, 0.09) 26px 28px);
+  animation: terraform-scan 8s linear infinite;
+  pointer-events: none;
+}
+.bg-terraform::after {
+  content: '';
+  position: absolute;
+  left: 0; right: 0; height: 90px;
+  background: linear-gradient(180deg, transparent, rgba(74, 222, 128, 0.25), transparent);
+  animation: terraform-beam 5s ease-in-out infinite alternate;
+  pointer-events: none;
+}
+@keyframes terraform-scan {
+  from { background-position: 0 0; }
