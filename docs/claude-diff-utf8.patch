+}
+
+.bg-eventhorizon {
+  background: radial-gradient(circle at 50% 45%, #000000 0%, #1E1B4B 32%, #0F172A 70%) !important;
+  position: relative;
+  overflow: hidden;
+  min-height: 100vh;
+  border-radius: 16px;
+  padding: 24px;
+}
+.bg-eventhorizon::before {
+  content: '';
