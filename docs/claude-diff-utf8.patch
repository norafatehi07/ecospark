+export const LOOT_CASES = [
+  {
+    id: 'bronze_case',
+    name: 'Bronze Case',
+    cost: 1000,
+    icon: '≡ƒôª',
+    color: '#CD7F32',
+    pool: ['bronze', 'silver', 'gold'],
+  },
+  {
+    id: 'silver_case',
+    name: 'Silver Case',
+    cost: 2500,
+    icon: '≡ƒº░',
+    color: '#C0C0C0',
+    pool: ['silver', 'gold', 'platinum'],
